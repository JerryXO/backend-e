{
  "compilerOptions": {
    "module": "CommonJS",
    "strict": true,
    "baseUrl": "./",
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": true,
    "experimentalDecorators": true,
    "target": "ES2020",
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./src/typings",
      "node_modules/@types"
    ]
  },
  "include": ["./src/**/*.ts"]
}